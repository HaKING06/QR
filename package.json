{
  "name": "qr-scanner",
  "version": "1.1.4",
  "private": true,
  "description": "Private multilingual QR scanner, generator and browser extension",
  "scripts": {
    "test": "node --test tests/core.test.cjs tests/updates.test.cjs",
    "build": "node tools/browser-icons.cjs && python tools/build.py",
    "check": "python tools/check.py",
    "build:static": "node tools/prepare-static.cjs",
    "build:edge-assets": "python tools/edge_assets.py",
    "build:chrome-assets": "python tools/chrome_assets.py",
    "build:chrome-package": "python tools/chrome_package.py",
    "build:website": "python tools/build.py --site-only"
  },
  "keywords": [],
  "author": "Halit (HaKING)",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "playwright": "1.65.0"
  }
}
